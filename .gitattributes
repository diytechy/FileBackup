# The git hook is an extensionless sh script — LF required on every platform
# (a CRLF shebang breaks `#!/bin/sh`, including Git Bash on Windows).
.githooks/pre-commit text eol=lf

# Bash restore variant (bash-v1): shell scripts and bats suites must be LF on
# every platform even when authored on Windows — a CRLF shebang breaks bash.
*.sh   text eol=lf
*.bash text eol=lf
*.bats text eol=lf
# macOS launcher: a .command is a shell script Finder runs in Terminal, so
# CRLF breaks its shebang exactly as it would for a .sh.
*.command text eol=lf
*.awk text eol=lf
recovery/path-keys.tsv text eol=lf

# Everything rust/src/kit.rs embeds must be pinned. core.autocrlf is true on the
# Windows dev PC, so an unpinned file enters the binary with whatever endings that
# checkout happens to hold, and the recovery kit then differs by build host.
*.psm1 text eol=lf
recovery/Reconstruct.ps1 text eol=lf
recovery/THIRD-PARTY-NOTICES.txt text eol=lf

# Windows batch launchers stay CRLF (LF-only batch can break cmd.exe parsing).
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Golden fixtures are byte-exact engine output (CRLF manifests, binary data,
# .7z archives) — never let git normalize them or the conformance check drifts.
tests/fixtures/** -text

# Exact upstream bytes are verified against the pinned import's SHA-256 map.
scripts/spine-kit/** text eol=lf
# Original registry evidence retains its historical bytes, including bad rows.
docs/plans/spine-rebaseline-2026-11-05/legacy/*.csv -text
