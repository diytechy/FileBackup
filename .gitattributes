# The git hook is an extensionless sh script — LF required on every platform
# (a CRLF shebang breaks `#!/bin/sh`, including Git Bash on Windows).
.githooks/pre-commit text eol=lf

# Bash restore variant (bash-v1): shell scripts and bats suites must be LF on
# every platform even when authored on Windows — a CRLF shebang breaks bash.
*.sh   text eol=lf
*.bats text eol=lf

# Golden fixtures are byte-exact engine output (CRLF manifests, binary data,
# .7z archives) — never let git normalize them or the conformance check drifts.
tests/fixtures/** -text
