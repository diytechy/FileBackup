# Personal media build output living in the working folder — never commit.
BuildAlbum/

# IDE-private config (removed from tracking 2026-07-03)
.idea/

# Test harness setup marker (created by tests/Setup.ps1)
tests/.setup-complete

# Generated by the gated-process tooling (scripts/trace.py, gen_release_checklist.py)
docs/test/report.md
# docs/release-checklist.md is tracked (WP6, 2026-08-23): it is the current
# G-Release checklist regenerated from the registries, kept navigable/current
# in the repo rather than as an untracked local artifact. --version-stamped
# per-release copies under docs/releases/ stay generated/gitignored until a
# real release ships and the completed, ticked copy is checked in by hand.
docs/releases/
__pycache__/

# Pester code-coverage output
coverage.xml

# Local OCI image exports from scripts/Invoke-Container.ps1 -Action Export
.artifacts/

# Local RealUSB volume map (tests/Config/real-volumes.json.example is the tracked template)
tests/Config/real-volumes.json
